# Copy to ~/.postgres-readonly/profiles.yaml or pass --profiles.
# Remove unused profiles. Tunnels must already be running.
# Never commit real profiles or credentials; descriptions are visible to agents.
profiles:
  staging:
    description: Staging application database
    host: 127.0.0.1
    port: 15432
    database: app
    user: mcp_reader
    password_env: PG_STAGING_READER_PASSWORD
    sslmode: verify-full
    ssl_servername: staging-db.example.com # Replace with the certificate hostname.
    # ssl_ca_file: /absolute/path/to/root-ca.pem
  local:
    description: Local development database
    host: 127.0.0.1
    port: 5432
    database: app
    user: mcp_reader
    password_env: PG_LOCAL_READER_PASSWORD
    sslmode: disable # Explicit opt-out: trusted local development only.
    # Prefer password_env. Inline passwords require chmod 600 on POSIX (ACLs on Windows).
